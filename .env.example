# Copy to task2go/.env before docker compose up.
# Generate a key with:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TASK_CONTROL_SECRET_KEYS='{"1":"REPLACE_WITH_32_BYTE_BASE64"}'
TASK_CONTROL_SECRET_ACTIVE_VERSION=1
TASK_CONTROL_COOKIE_SECURE=false
TASK_CONTROL_WORKER_CONCURRENCY=4
TASK_CONTROL_LOG_LEVEL=INFO

# Required: PostgreSQL connection. Local binary: use 127.0.0.1.
# Docker Compose: use host.docker.internal to reach a host database.
TASK_CONTROL_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/task_control
TASK_CONTROL_API_PORT=8010
